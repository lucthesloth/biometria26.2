            \ifcsvoid{\csuse{ATag}Lattes}{}{.\ \Lattes{\csuse{\csuse{ATag}Lattes}}}%
            \ifcsvoid{\csuse{ATag}ORCID}{}{.\ \ORCID{\csuse{\csuse{ATag}ORCID}}}.%
          }%
        }%
      }%
      \csgundef{ATag}%
    }%
